{
  "name": "react-example",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "ui:verify-mobile-home": "node scripts/verify-mobile-home-simplification.mjs",
    "weather:verify-current-truth": "node scripts/verify-current-weather-truth.mjs",
    "android:verify-background-watch": "node scripts/verify-android-background-watch.mjs",
    "android:verify-modern-target": "node scripts/verify-android-modern-target.mjs",
    "android:verify-runtime-readiness": "node scripts/verify-android-runtime-readiness.mjs",
    "android:verify-premium-widget": "node scripts/verify-premium-widget-snapshot.mjs",
    "android:verify-widget-refresh": "node scripts/verify-widget-refresh-fanout.mjs",
    "android:sync": "cap sync android",
    "android:doctor": "cap doctor android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:clean-build": "powershell -ExecutionPolicy Bypass -File scripts/rebuild-android-clean.ps1",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:vscode-setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-android-vscode.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",

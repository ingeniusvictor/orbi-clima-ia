<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orbi_widget_background_dark"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_initial_orb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/orbi_widget_orb_sunny"
        android:contentDescription="Climate Orb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORBI SkyOrb"
            android:textColor="#67E8F9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu núcleo climático inteligente"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORBI SkyCore™ Activo"
            android:textColor="#22C55E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
